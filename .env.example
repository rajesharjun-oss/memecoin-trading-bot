SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
SOLANA_KEYPAIR_PATH=C:/Users/YOUR_NAME/.solana/memecoin-bot-keypair.json
JUPITER_API_KEY=YOUR_JUPITER_SERVER_KEY
# Optional research-only key for bounded historical pool OHLCV backfills.
COINGECKO_DEMO_API_KEY=
# Optional server-side key from https://developers.pump.fun. Never expose it in browser code.
PUMP_API_KEY=
DEXSCREENER_DISCOVERY_ENABLED=true

# Keyless, fixed-host public narrative feeds. These signals never bypass trading gates.
NARRATIVE_INTELLIGENCE_ENABLED=true
NARRATIVE_GDELT_ENABLED=true
NARRATIVE_GOOGLE_NEWS_ENABLED=true
NARRATIVE_BLUESKY_ENABLED=true
NARRATIVE_REFRESH_INTERVAL_SECONDS=300
# Optional paid OpenAI research of already linked public items, off by default.
# Create a project key at https://platform.openai.com/api-keys and keep it local.
OPENAI_API_KEY=
NARRATIVE_OPENAI_ENABLED=false
NARRATIVE_OPENAI_DAILY_LIMIT=10
# Optional paper-worker alerts. Use a private chat; no bot token is sent to the dashboard.
ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TOKEN_FORENSICS_ENABLED=true
FORENSICS_ORIGIN_TRACE_ENABLED=true
FORENSICS_MAX_SINGLE_CONTROLLER_BPS=1500
FORENSICS_SIGNATURE_LIMIT=100
FORENSICS_TRANSACTION_CANDIDATES=5

# Safe defaults. Keep live trading disabled until dry-run testing is complete.
LIVE_TRADING_ENABLED=false
MAX_TRADE_LAMPORTS=50000000
MAX_DAILY_LAMPORTS=100000000
MAX_SLIPPAGE_BPS=300
MAX_PRICE_IMPACT_BPS=500
MAX_TOP10_CONCENTRATION_BPS=7000
MAX_PRIORITY_FEE_LAMPORTS=1000000
CONFIRMATION_TIMEOUT_SECONDS=45
# Opt in only after reviewing the mint-extension audit; unknown or mutable extensions fail closed.
ALLOW_TOKEN_2022=false
TRADE_STATE_PATH=./trade-state.sqlite3

# Bounded discovery and paper-trading defaults. Program IDs are the official Pump
# bonding-curve and PumpSwap fallback; comma-separate overrides if required.
DISCOVERY_PROGRAM_IDS=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P,pAMMBay6oceH9fJKBRHGP5D4bD4sWpmSwMn52FMfXEA
DISCOVERY_SIGNATURES_PER_PROGRAM=8
DISCOVERY_MAX_TRANSACTIONS=30
DISCOVERY_CANDIDATE_LIMIT=20
PAPER_STARTING_LAMPORTS=1000000000

# Explainable paper-strategy gates. The decision engine never enables live trading.
STRATEGY_MIN_LIQUIDITY_USD=25000
STRATEGY_MIN_VOLUME_24H_USD=10000
STRATEGY_MIN_SCORE=65
PAPER_RISK_PER_TRADE_BPS=100
STRATEGY_MAX_OPEN_POSITIONS=3

# Autonomous paper worker. This scheduler can never submit a wallet transaction.
PAPER_AUTOMATION_AUTOSTART=false
PAPER_AUTOMATION_INTERVAL_SECONDS=300
# Profit thresholds and portions of the ORIGINAL position sold at each threshold.
# Defaults: sell 50% at +100%, 20% at +300%, and 15% at +900%; retain 15%.
PAPER_TP_LEVELS_BPS=10000,30000,90000
PAPER_TP_SELL_BPS=5000,2000,1500
PAPER_STOP_LOSS_BPS=3500
PAPER_TRAILING_ACTIVATION_BPS=3000
PAPER_TRAILING_STOP_BPS=1500
PAPER_MAX_HOLD_SECONDS=86400
PAPER_MAX_DRAWDOWN_BPS=1000

# Entry circuit breakers. Exits continue to be managed while a breaker is active.
PAPER_DAILY_LOSS_BPS=500
PAPER_MAX_CONSECUTIVE_LOSSES=3
PAPER_LIQUIDITY_BREAKER_USD=15000

# Conservative paper-fill model. Quotes older than the freshness limit or trades
# above the visible-liquidity share are rejected. Explicit costs are debited from
# paper cash and every assumption is retained in the local fill journal.
PAPER_EXECUTION_BASE_SLIPPAGE_BPS=30
PAPER_EXECUTION_LIQUIDITY_SHOCK_BPS=0
PAPER_EXECUTION_NETWORK_FEE_LAMPORTS=5000
PAPER_EXECUTION_PRIORITY_FEE_LAMPORTS=50000
PAPER_EXECUTION_ATA_RENT_LAMPORTS=2039280
PAPER_EXECUTION_MAX_QUOTE_AGE_MS=5000
PAPER_EXECUTION_MAX_TRADE_LIQUIDITY_BPS=100

# Restart-safe local operations. Backups contain trading state but never the wallet key.
OPERATIONS_BACKUP_ENABLED=true
OPERATIONS_BACKUP_INTERVAL_SECONDS=86400
OPERATIONS_BACKUP_DIRECTORY=./state-backups

# Local Strategy Lab history. This collector reads public market data only and can
# never sign or submit a transaction.
STRATEGY_LAB_COLLECTION_ENABLED=true
STRATEGY_LAB_COLLECTION_INTERVAL_SECONDS=30
